# Environment variables for CoughDrop WebSocket
# Copy this file to .env and fill in your actual values

# Required for room authentication
SHARED_VERIFIER=your_shared_verifier_secret_here

# Required for admin access
ADMIN_KEY=your_admin_key_here

# Redis configuration (REQUIRED - the app won't work without Redis)
REDIS_URL=redis://localhost:6379/0

# AnyCable Redis URL (optional, uses REDIS_URL if not set)
ANYCABLE_REDIS_URL=redis://localhost:6379/1

# Database configuration (if using PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost/coughdrop_websocket

# Action Cable adapter (any_cable for AnyCable, redis for standard Action Cable)
ACTION_CABLE_ADAPTER=any_cable

# AnyCable deployment mode
ANYCABLE_DEPLOYMENT=true
