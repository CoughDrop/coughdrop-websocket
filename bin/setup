#!/usr/bin/env bash
set -o errexit

echo "== Installing dependencies =="
bundle install

echo "== Checking Redis =="
if ! command -v redis-cli &> /dev/null; then
    echo "Redis is not installed. Installing Redis..."
    # For macOS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        brew install redis
        brew services start redis
    else
        # For Ubuntu/Debian
        sudo apt-get update
        sudo apt-get install -y redis-server
        sudo systemctl start redis-server
    fi
else
    echo "Redis is installed"
    # Check if Redis is running
    if redis-cli ping &> /dev/null; then
        echo "Redis is running"
    else
        echo "Starting Redis..."
        if [[ "$OSTYPE" == "darwin"* ]]; then
            brew services start redis
        else
            sudo systemctl start redis-server
        fi
    fi
fi

echo "== Installing anycable-go =="
# Check if anycable-go is already installed
if ! command -v anycable-go &> /dev/null; then
    echo "Installing anycable-go..."
    # For macOS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        brew install anycable-go
    else
        # For Linux, download binary
        curl -L https://github.com/anycable/anycable-go/releases/latest/download/anycable-go-linux-amd64 -o /usr/local/bin/anycable-go
        chmod +x /usr/local/bin/anycable-go
    fi
else
    echo "anycable-go is already installed"
fi

echo "== Setting up database =="
bin/rails db:create db:migrate

echo "== Clearing Redis cache =="
redis-cli flushall
echo "Redis cache cleared"

echo "== Setup complete! =="
echo ""
echo "IMPORTANT: Set up environment variables:"
echo "  cp env.example .env"
echo "  # Edit .env with your actual values (especially SHARED_VERIFIER and ADMIN_KEY)"
echo ""
echo "To start the development server with AnyCable:"
echo "  bin/dev"
echo ""
echo "Or start individual processes:"
echo "  bundle exec rails server     # Rails server"
echo "  bundle exec anycable         # AnyCable RPC server"
echo "  anycable-go --port=8080      # AnyCable WebSocket server"
echo ""
echo "To clear Redis cache (if you have issues):"
echo "  bin/clear-redis"
